# GitHub Pages deployment (no secrets required for default *.github.io domain)

# Optional: Custom domain
# CNAME=yourdomain.com

# Optional: Analytics
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# PLAUSIBLE_DOMAIN=yourdomain.com

# Optional: Formspree form ID (replace YOUR_FORM_ID)
# FORMSPREE_ID=YOUR_FORM_ID